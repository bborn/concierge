<h1>Routines</h1>
<table>
  <thead><tr><th>Agent</th><th>Account</th><th>Schedule</th><th>Instruction</th><th>Author</th><th>Next run</th><th>Enabled</th></tr></thead>
  <tbody>
    <% @routines.each do |r| %>
      <tr>
        <td><%= r.agent_slug %></td>
        <td><%= subject_label(r) %></td>
        <td><%= r.schedule %></td>
        <td><%= r.instruction %></td>
        <td><%= r.author %></td>
        <td><%= r.next_run_at %></td>
        <td><%= r.enabled? ? "yes" : "no" %></td>
      </tr>
    <% end %>
  </tbody>
</table>
