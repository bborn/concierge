<h1>Agents <small>(Phase 10 step-0 spike)</small></h1>

<p>
  Two business functions over the same <code>Tenant</code> subjects. Each owns its
  persona, tool scope, authority envelope, and memory namespace.
</p>

<h2>Declared agents</h2>
<table>
  <thead>
    <tr>
      <th>Slug</th><th>Persona</th><th>Model</th><th>Tool scope</th>
      <th>Authority</th><th>Memory namespace</th><th>Enabled</th>
    </tr>
  </thead>
  <tbody>
    <% @agents.each do |agent| %>
      <tr>
        <td><code><%= agent.slug %></code></td>
        <td>
          <%= agent.playbook.persona.name || "—" %>
          <br><em><%= agent.playbook.persona.voice %></em>
        </td>
        <td><%= agent.model || "(default)" %></td>
        <td>
          <% agent.capabilities.entries.each do |entry| %>
            <%= entry.tool_class.name.demodulize %> <em>(<%= entry.access %>)</em><br>
          <% end %>
        </td>
        <td>
          default: <strong><%= agent.authority.default %></strong><br>
          <% agent.authority.actions.each do |action_class, level| %>
            <code><%= action_class %></code>: <strong><%= level %></strong><br>
          <% end %>
        </td>
        <td>
          <code><%= agent.memory_namespace %>/…</code>
          — <%= @namespaces.select { |ns, _| ns.to_s.start_with?("#{agent.memory_namespace}/") }.values.sum %> rows
        </td>
        <td><%= agent.enabled? ? "yes" : "no (halted)" %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<h2>Memory namespaces</h2>
<p>
  Live row counts from <code>concierge_memories</code>. The spike fakes the
  <code>agent_slug</code> column by folding the slug into <code>subject_type</code>,
  so the namespace is visible here and on
  <%= link_to "Memories", admin_memories_path %>.
  <code>_shared</code> is the one namespace every agent also reads.
</p>
<table>
  <thead><tr><th>Namespace</th><th>Active memories</th></tr></thead>
  <tbody>
    <% @namespaces.sort.each do |namespace, count| %>
      <tr><td><code><%= namespace %></code></td><td><%= count %></td></tr>
    <% end %>
  </tbody>
</table>

<h2>Run every agent on one account</h2>
<p>Each run is independent: its own prompt, its own memory, its own provenance row.</p>
<table>
  <thead><tr><th>Account</th><th>Plan</th><th></th></tr></thead>
  <tbody>
    <% @subjects.each do |subject| %>
      <tr>
        <td><%= subject[:name] %></td>
        <td><%= subject[:plan] %></td>
        <td><%= button_to "Run all agents", admin_spike_runs_path,
                  params: { subject_id: subject.id } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<h2>Per-run provenance (§10.4)</h2>
<% if @provenance.empty? %>
  <p><em>No runs recorded yet — run an account above.</em></p>
<% else %>
  <table>
    <thead>
      <tr>
        <th>Agent</th><th>Subject</th><th>Trigger</th><th>Memory ids injected</th>
        <th>Snapshot digest</th><th>Model</th><th>Tokens</th><th>At</th>
      </tr>
    </thead>
    <tbody>
      <% @provenance.each do |row| %>
        <tr>
          <td><code><%= row.agent_slug %></code></td>
          <td><%= row.subject_label %></td>
          <td><%= row.trigger %></td>
          <td><%= row.memory_ids.join(", ").presence || "—" %></td>
          <td><code><%= row.snapshot_digest.first(12) %></code></td>
          <td><%= row.model %></td>
          <td><%= row.total_tokens %></td>
          <td><%= row.recorded_at.strftime("%H:%M:%S") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<p>
  <%= link_to "Memories", admin_memories_path %> ·
  <%= link_to "Routines", admin_routines_path %> ·
  <%= link_to "Deliveries", admin_deliveries_path %>
</p>
