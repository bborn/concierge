<h1>Delivery audit log</h1>
<table>
  <thead><tr><th>Account</th><th>Channel</th><th>Kind</th><th>Sent at</th></tr></thead>
  <tbody>
    <% @deliveries.each do |d| %>
      <tr>
        <td><%= d.subject_type %>#<%= d.subject_id %></td>
        <td><%= d.channel %></td>
        <td><%= d.kind %></td>
        <td><%= d.sent_at %></td>
      </tr>
    <% end %>
  </tbody>
</table>
