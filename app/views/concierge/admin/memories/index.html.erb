<h1>Memories</h1>
<table>
  <thead>
    <tr><th>Agent</th><th>Account</th><th>Source</th><th>Category</th><th>Body</th><th>Pinned</th><th></th></tr>
  </thead>
  <tbody>
    <% @memories.each do |m| %>
      <tr>
        <td><%= m.agent_slug %></td>
        <td><%= m.subject_type %>#<%= m.subject_id %></td>
        <td><%= m.source %></td>
        <td><%= m.category %></td>
        <td><%= m.body %></td>
        <td><%= m.pinned? ? "yes" : "no" %></td>
        <td>
          <%= button_to (m.pinned? ? "Unpin" : "Pin"), admin_memory_path(m),
                method: :patch, params: { memory: { pinned: !m.pinned } } %>
          <%= button_to "Retire", admin_memory_path(m), method: :delete %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
