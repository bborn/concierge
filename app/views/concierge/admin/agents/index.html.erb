<h1>Agents</h1>

<p>
  Identity is <strong>(Agent&nbsp;×&nbsp;Subject)</strong>: every memory, conversation,
  routine, delivery and handoff below is keyed by the pair, so no agent can read
  another's notes about the same account.
</p>

<% @agents.each do |agent| %>
  <h2><%= agent.slug %><%= " — off" unless agent.enabled? %></h2>

  <table>
    <tbody>
      <tr>
        <th>Persona</th>
        <td>
          <%= agent.playbook.persona.name || "(unnamed)" %>
          <% if agent.playbook.persona.voice %> — <%= agent.playbook.persona.voice %><% end %>
        </td>
      </tr>
      <tr>
        <th>Model</th>
        <td><%= agent.model || "#{Concierge.config.default_model} (house default)" %></td>
      </tr>
      <tr>
        <th>Charter</th>
        <td>
          <%= agent.playbook.product_brief %>
          <% if agent.playbook.engagement_signals.any? %>
            <br>Signals: <%= agent.playbook.engagement_signals.keys.join(", ") %>
          <% end %>
        </td>
      </tr>
      <tr>
        <th>Tool scope</th>
        <td>
          <% if agent.capabilities.entries.any? %>
            <%= agent.capabilities.entries.map { |e| "#{e.tool_class.name.demodulize} (#{e.access})" }.join(", ") %>
          <% else %>
            none
          <% end %>
        </td>
      </tr>
      <tr>
        <th>Authority</th>
        <td>
          default <%= agent.authority.default %>
          <% agent.authority.actions.each do |action_class, level| %>
            &middot; <%= action_class %> <%= level %>
          <% end %>
          <% if Concierge.config.draft_and_review %>
            <br>the legacy <code>draft_and_review</code> flag is on, so
            <code>message.outreach</code> gates to
            <strong><%= agent.level_for(Concierge::Authority::MESSAGE_OUTREACH) %></strong>
          <% end %>
        </td>
      </tr>
      <tr>
        <th>Proposals</th>
        <td>
          <% if @actions.fetch(agent.memory_namespace, 0).positive? %>
            <strong><%= link_to pluralize(@actions.fetch(agent.memory_namespace, 0), "action"),
                                admin_proposals_path %> awaiting approval</strong>
          <% else %>
            nothing staged for a human
          <% end %>
        </td>
      </tr>
      <tr>
        <th>Slack</th>
        <td>
          <% if (channel = Concierge.config.slack.channel(agent.memory_namespace)) %>
            cards post to <code><%= channel %></code> &middot;
            <%= link_to "intake", admin_slack_path %>
          <% else %>
            <%= link_to "no channel", admin_slack_path %> — this agent's proposals
            wait in the queue only
          <% end %>
        </td>
      </tr>
      <tr>
        <th>Memory namespace</th>
        <td><code><%= agent.memory_namespace %></code></td>
      </tr>
      <tr>
        <th>Rules in force</th>
        <td>
          <%= link_to pluralize(@rules.fetch(agent.memory_namespace, 0), "active rule"), admin_rules_path %>
          of <%= Concierge::Rules.cap %> allowed
          <% if @proposals.fetch(agent.memory_namespace, 0).positive? %>
            &middot; <strong><%= @proposals.fetch(agent.memory_namespace, 0) %> awaiting a human tap</strong>
          <% end %>
        </td>
      </tr>
      <tr>
        <th>Kill switch</th>
        <td><%= agent.enabled? ? "enabled" : "DISABLED — runs are suppressed" %></td>
      </tr>
      <tr>
        <th>State owned</th>
        <td>
          <%= @memories.fetch(agent.memory_namespace, 0) %> memories &middot;
          <%= @conversations.fetch(agent.memory_namespace, 0) %> conversations &middot;
          <%= @routines.fetch(agent.memory_namespace, 0) %> routines &middot;
          <%= @deliveries.fetch(agent.memory_namespace, 0) %> deliveries
        </td>
      </tr>
    </tbody>
  </table>
<% end %>

<h2>Shared namespace</h2>
<p>
  <code><%= Concierge::Scope::SHARED %></code> holds
  <%= @memories.fetch(Concierge::Scope::SHARED, 0) %> memories — facts about the
  relationship every agent on that account legitimately reads. Writing there is an
  explicit opt-in; reading is automatic.
</p>
