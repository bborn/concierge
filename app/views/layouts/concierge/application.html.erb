<!DOCTYPE html>
<html>
<head>
  <title>Concierge</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= yield :head %>

  <%= stylesheet_link_tag    "concierge/application", media: "all" %>
</head>
<body>

<% if flash[:notice].present? || flash[:alert].present? %>
  <p class="concierge-flash <%= flash[:alert].present? ? 'concierge-flash--alert' : '' %>">
    <%= flash[:alert].presence || flash[:notice] %>
  </p>
<% end %>

<%= yield %>

</body>
</html>
