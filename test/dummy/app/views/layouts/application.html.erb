<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Acme" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="Acme">

    <%# The chat widget reads this token and sends it as X-CSRF-Token, which is
        the whole reason the engine's chat endpoint needs a host-rendered page. %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag "application" %>
  </head>

  <body>
    <%= render "shared/topbar" if signed_in? %>

    <main class="page">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>

    <%= render "shared/chat_widget" if signed_in? %>
  </body>
</html>
