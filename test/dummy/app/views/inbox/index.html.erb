<% content_for :title, "Inbox · Acme" %>

<div class="page__head">
  <div>
    <h1>Inbox</h1>
    <p class="lede">
      What <%= csm_persona&.name || "your agent" %> and the billing team have sent
      <%= current_tenant.name %> in the app — and where you answer them. A reply goes
      back to the agent that wrote to you, quoting their message.
    </p>
  </div>
  <% if inbox.unread_count.positive? %>
    <%= button_to "Mark all read", read_all_inbox_path, class: "btn", form_class: "inline-form" %>
  <% end %>
</div>

<%# The live list. The layout already subscribes this page to the account's
    stream; these are the two targets it pushes at — a new message is prepended
    here and the empty card is removed, so an inbox that fills up while you are
    looking at it fills up in front of you.

    `.card--flush` is on the container rather than around it so a prepended row
    lands inside the card it belongs to. Empty, the container collapses (see
    `#inbox-messages:empty` in application.css) rather than drawing a stray box
    above the empty state. %>
<div class="card card--flush" id="inbox-messages">
  <%= render partial: "inbox/message", collection: @items, as: :item %>
</div>

<% if @items.empty? %>
  <div class="card empty" id="inbox-empty">
    <h2>Nothing yet</h2>
    <p>
      When <%= csm_persona&.name || "your agent" %> has something worth saying, it lands here.
      <% if Rails.env.local? %>
        You don't have to wait for the weekly sweep — open the chat panel and hit
        “<%= csm_persona&.name || "Agent" %>, take a look”.
      <% end %>
    </p>
  </div>
<% end %>

<p class="faint">
  Every one of these has an audit row on the operator side:
  <%= link_to "delivery log", concierge.admin_deliveries_path %> ·
  <%= link_to "run provenance", concierge.admin_runs_path %>.
</p>

<script>
  // Closing the gap between rendering this page and subscribing to the stream.
  //
  // A broadcast is fire-and-forget: anything pushed in the moment between the
  // server rendering these cards and the browser's socket being confirmed
  // reaches nobody. Against a real provider that window is invisible, because a
  // model turn takes seconds. Offline it is the *normal* case — Dummy::
  // ScriptedChat answers in about 80ms, comfortably inside a POST → redirect →
  // GET, so the answer beats the subscription and the card sits on "Kit is
  // replying…" until someone reloads. Which is the bug this whole change is
  // about, wearing a different hat.
  //
  // So: once the socket is up, reconcile once against the server. This is not a
  // poll and must not become one — it runs at most once per page load, and only
  // when something on the page is still waiting. A turn that is genuinely slow
  // re-renders as still-pending and we stop there, because by then the stream is
  // connected and the answer will arrive the way it is supposed to.
  //
  // Vanilla and inline, like the chat widget: the demo host ships no bundler.
  (function () {
    var source = document.querySelector("turbo-cable-stream-source");
    if (!source) return;

    function catchUp() {
      if (!document.querySelector("[data-pending]")) return;

      fetch(location.pathname, { headers: { Accept: "text/html" }, credentials: "same-origin" })
        .then(function (response) { return response.ok ? response.text() : null; })
        .then(function (html) {
          if (!html) return;
          var fresh = new DOMParser().parseFromString(html, "text/html");
          [ "inbox-messages", "inbox-badge" ].forEach(function (id) {
            var next = fresh.getElementById(id), here = document.getElementById(id);
            if (next && here) here.replaceWith(next);
          });
        })
        .catch(function () { /* the stream is the path; this is only the net */ });
    }

    if (source.hasAttribute("connected")) return catchUp();

    new MutationObserver(function (_records, observer) {
      if (!source.hasAttribute("connected")) return;
      observer.disconnect();
      catchUp();
    }).observe(source, { attributes: true, attributeFilter: [ "connected" ] });
  })();
</script>
